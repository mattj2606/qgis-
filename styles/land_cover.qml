        <paletteEntry value="3" color="#0000ff" label="Water" alpha="255"/>
        <paletteEntry value="4" color="#ff4500" label="Built-up" alpha="255"/>
        <paletteEntry value="5" color="#d2b48c" label="Bare Soil" alpha="255"/>
        <paletteEntry value="6" color="#ffffff" label="Snow/Ice" alpha="255"/>
        <paletteEntry value="7" color="#808080" label="Cloud/Shadow" alpha="255"/>
      </colorPalette>
    </rasterrenderer>
  </pipe>
  <blendMode>0</blendMode>
</qgis>
